{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "favicon/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/bot/weather/batch", "dest": "api/bot/weather/batch.js" },
    { "src": "/api/bot/weather", "dest": "api/bot/weather.js" },
    { "src": "/api/city-ranking", "dest": "api/city-ranking.js" },
    { "src": "/api/test-models", "dest": "api/test-models.js" },
    { "src": "/api/metar", "dest": "api/metar.js" },
    { "src": "/api/forecast", "dest": "api/forecast.js" },
    { "src": "/api/temperature", "dest": "api/temperature.js" },
    { "src": "/", "dest": "index.html" },
    { "src": "/assets/(.*)", "dest": "assets/$1" },
    { "src": "/favicon/(.*)", "dest": "favicon/$1" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
